# Used by GoReleaser only. GoReleaser builds the binary for each target arch
# and places it in the Docker build context before calling docker buildx build.
# For local builds use the main Dockerfile instead.
# Pinned by digest, and deliberately the same digest as the runtime stage of the
# main Dockerfile: a local build and a released image should not differ in what
# they are built on. Dependabot bumps both together.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
COPY k2a-token-sync /k2a-token-sync
ENTRYPOINT ["/k2a-token-sync"]
